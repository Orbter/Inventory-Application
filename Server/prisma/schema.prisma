generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  
}

model Items {
  id         Int   @id @default(autoincrement())
  quantity   Int
  name       String
  categoryId Int @map("category_id")
  category   Categories @relation(fields: [categoryId], references: [id])
  price      Decimal
  createdAt  DateTime @default(now()) @map("created_at")
}

model Categories {
  id    Int @id @default(autoincrement())
  name  String
  items Items[]
}