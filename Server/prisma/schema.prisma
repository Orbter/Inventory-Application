generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Item {
  id         BigInt   @id @default(autoincrement())
  quantity   Int
  name       String
  categoryId BigInt
  category   Category @relation(fields: [categoryId], references: [id])
  price      Decimal
  createdAt  DateTime @default(now())
}

model Category {
  id    BigInt @id @default(autoincrement())
  name  String
  items Item[]
}