generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  
}

model Items {
  id         BigInt   @id @default(autoincrement())
  quantity   Int
  name       String
  categoryId BigInt @map("category_id")
  category   Categories @relation(fields: [categoryId], references: [id])
  price      Decimal
  createdAt  DateTime @default(now())
}

model Categories {
  id    BigInt @id @default(autoincrement())
  name  String
  items Items[]
}